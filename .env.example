# Copy to .env and fill in. All values are read at process start.

# --- required for the admin API ---
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BEAMLINE_ADMIN_TOKEN=

# --- beacon signing ---
# Generate: beamline beacon-key
# Unset means pulses are chained but UNSIGNED: still tamper-evident to anyone who
# recorded an earlier pulse, but not attributable to you by a third party.
# Move this to a KMS/HSM before taking payment. If it leaks, every pulse you ever
# signed becomes deniable.
BEAMLINE_BEACON_KEY=

# --- entropy sources ---
# Official metered ANU API. Strongly recommended for production: it replaces the
# scraped public endpoint with a real contract. https://quantumnumbers.anu.edu.au/
BEAMLINE_ANU_API_KEY=
BEAMLINE_ANU_POLL_SECONDS=20
BEAMLINE_ASTRO_POLL_SECONDS=60

# --- DRBG reseed policy (whichever comes first) ---
BEAMLINE_RESEED_SECONDS=60
BEAMLINE_RESEED_BYTES=16777216

# --- beacon cadence ---
BEAMLINE_BEACON_PERIOD_SECONDS=60

# --- server ---
BEAMLINE_HOST=127.0.0.1
BEAMLINE_PORT=8080
BEAMLINE_DB=data/beamline.db
BEAMLINE_SEED_POOL=data/anu_seed_pool.txt
